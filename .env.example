# ============================================================
# EduConnect — Environment Variables
# ============================================================

# Database
POSTGRES_USER="educonnect"
POSTGRES_PASSWORD="EduConnect@2026"
POSTGRES_DB="educonnect"
DATABASE_URL="postgresql://educonnect:EduConnect@2026@localhost:8002/educonnect?schema=public"

# JWT
JWT_SECRET="EduConnect_JWT_Secret_2026"
JWT_REFRESH_SECRET="EduConnect_Refresh_Secret_2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Argon2
ARGON2_SECRET="optional-pepper-for-argon2"

# S3 / R2 File Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="educonnect-uploads"
S3_ACCESS_KEY="educonnect_s3_access_key"
S3_SECRET_KEY="educonnect_s3_secret_key"
S3_REGION="auto"

# SMTP Email
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER="educonnect_smtp"
SMTP_PASS="EduConnect_SMTP_2026"
SMTP_FROM="noreply@educonnect.local"

# App URLs
APP_URL="http://localhost:8003"
API_URL="http://localhost:8001"

# Frontend (Vite — phải có prefix VITE_)
VITE_API_URL="http://localhost:8001/api"

# Seed Admin Account
ADMIN_EMAIL="admin@educonnect.local"
ADMIN_PASSWORD="Admin@123"
